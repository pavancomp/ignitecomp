# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ignite_user:password@localhost:5432/ignite_engine
DATABASE_URL_SYNC=postgresql://ignite_user:password@localhost:5432/ignite_engine

# ── JWT — CHANGE THIS IN PRODUCTION ──────────────────────────────────────
SECRET_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-STRING-IN-PRODUCTION

# ── External integrations (set to real URLs when ready) ───────────────────
ECOMMERCE_API=https://mock-ecom.example.com/api
ECOMMERCE_API_KEY=your-ecom-api-key
CRM_API=https://mock-crm.example.com/api
CRM_API_KEY=your-crm-api-key

# ── India compliance (all INR) ─────────────────────────────────────────
TDS_RATE=0.05
TDS_THRESHOLD_INR=15000
GST_REGISTRATION_THRESHOLD_INR=2000000

# ── CORS — restrict in production ────────────────────────────────────────
# CORS_ORIGINS=["https://your-frontend.com"]

# ── App ───────────────────────────────────────────────────────────────────
DEBUG=false
